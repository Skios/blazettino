# Copia in .env (non versionato) e compila. Una riga per chiave: `chiave: valore` oppure `chiave=valore`.

# WarcraftLogs API v2 (client credentials): https://www.warcraftlogs.com/api/clients
clientId=<client id>
secret=<client secret>

# Google AI Studio (https://aistudio.google.com/apikey), serve per i commenti con backend "gemini".
geminiKey=<chiave>
# Facoltative, di riserva: usate in ordine solo quando la precedente risponde 429 (quota esaurita).
# geminiKey2=<chiave>
# geminiKey3=<chiave>
